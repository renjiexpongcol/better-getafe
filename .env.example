PORT=8080
# Per-instance application request ceilings. Edge protection should remain the
# primary DDoS control; see docs/DDOS_PROTECTION.md before going live.
# Redis is the primary shared limiter state store. The local fallback remains
# bounded and is used only while Redis is unavailable.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=getafe
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_MAX_DELAY_MS=30000
# For the Compose app container, use redis://getafe-redis:6379.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=120
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_SUSTAINED_WINDOW_MS=900000
RATE_LIMIT_AUTH_SUSTAINED_MAX=30
RATE_LIMIT_OTP_WINDOW_MS=60000
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_CONTACT_WINDOW_MS=60000
RATE_LIMIT_CONTACT_MAX=5
# Optional shared Redis state alias kept for existing deployments.
# RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379
# Comma-separated CIDRs of reverse proxies you operate. Forwarded client-IP
# headers are ignored unless the immediate peer matches one of these ranges.
RATE_LIMIT_TRUSTED_PROXY_CIDRS=
RATE_LIMIT_PUBLIC_PER_MINUTE=240
RATE_LIMIT_PUBLIC_BURST=40
RATE_LIMIT_GENERAL_BURST=30
RATE_LIMIT_API_MAX_DELAY_MS=500
# Signed-in residents and CMS staff use separate identity buckets instead of
# the anonymous public bucket. Keep the service secret out of source control.
RATE_LIMIT_AUTHENTICATED_MAX=1200
RATE_LIMIT_AUTHENTICATED_BURST=200
RATE_LIMIT_ADMIN_STAFF_MAX=2400
RATE_LIMIT_ADMIN_STAFF_BURST=400
RATE_LIMIT_EXPENSIVE_MAX=30
RATE_LIMIT_EXPENSIVE_BURST=8
INTERNAL_SERVICE_ID=
INTERNAL_SERVICE_SECRET=
INTERNAL_SERVICE_MAX_SKEW_MS=60000
RATE_LIMIT_UPLOADS_PER_MINUTE=12
RATE_LIMIT_UPLOADS_BURST=4
RATE_LIMIT_UPLOADS_MAX_DELAY_MS=100
RATE_LIMIT_MEDIA_READ_PER_MINUTE=180
RATE_LIMIT_MEDIA_READ_BURST=40
RATE_LIMIT_MEDIA_READ_MAX_DELAY_MS=250
RATE_LIMIT_ADMIN_PER_MINUTE=120
RATE_LIMIT_ADMIN_BURST=30
RATE_LIMIT_ADMIN_MAX_DELAY_MS=250
RATE_LIMIT_MAX_QUEUE_DEPTH=100
RATE_LIMIT_MAX_DELAYED_REQUESTS_PER_CLIENT=2
RATE_LIMIT_MAX_GLOBAL_DELAYED_REQUESTS=100
RATE_LIMIT_MAX_ACTIVE_REQUESTS=200
# Authentication has a short burst limit plus a longer sustained limit.
# RATE_LIMIT_AUTH_BURST and RATE_LIMIT_AUTH_SUSTAINED_BURST may be used to
# tune token-bucket burst capacity independently of the configured maxima.
# Verification-code and MFA endpoints use a stricter separate policy.
RATE_LIMIT_OTP_SUSTAINED_WINDOW_MS=900000
RATE_LIMIT_OTP_SUSTAINED_MAX=20
# Contact form application-layer limits. The CDN/WAF remains responsible for
# volumetric DDoS mitigation.
CONTACT_RATE_LIMIT_10M=5
CONTACT_RATE_LIMIT_24H=20
# Optional notification recipient; leave blank to store messages without email.
CONTACT_NOTIFICATION_EMAIL=
OPENWEATHER_API_KEY=
ACCUWEATHER_API_KEY=
APP_NAME=Municipality of Getafe
COMPANY_NAME=Municipality of Getafe
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en-PH
APP_CURRENCY=PHP
NODE_ENV=development
PUBLIC_SITE_URL=https://getafe.gov.ph
# Optional comma-separated origins for approved cross-origin API clients.
API_CORS_ORIGINS=
# Optional official Facebook Page URL used by the homepage social feed.
VITE_GETAFE_FACEBOOK_URL=
# Google OAuth (configure the same origins and redirect URI in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Optional SMS identity verification for Google-account onboarding (Semaphore PH)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
AUTH_LOCAL_FALLBACK=false

# Session Secrets (use one strong Secret Manager value across all Cloud Run instances)
AUTH_SESSION_SECRET=replace-with-a-long-random-secret-before-production
AUTH_SESSION_IDLE_MINUTES=30
# Optional dedicated 32+ character key for encrypting authenticator secrets.
# If omitted, AUTH_SESSION_SECRET is used.
MFA_ENCRYPTION_KEY=
# CMS_SESSION_SECRET remains supported as a legacy alias.
# CMS accounts are provisioned through the CMS access-management flow. Do not
# commit a default administrator password to this file.

# PostgreSQL database (used for CMS and portal users in local development)
CMS_DATABASE_PROVIDER=postgresql
PORTAL_DATABASE_PROVIDER=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=getafe_portal
DB_USER=getafe_app
# Local-only development password used by docker-compose.yml. Change it for shared or production environments.
DB_PASSWORD=getafe_local_dev_password
DB_SSL=false
USER_DB_NAME=getafe_portal
USER_DB_USER=getafe_app
USER_DB_PASS=getafe_local_dev_password

# Local filesystem storage keeps a fresh clone runnable without cloud credentials.
# Set CMS_MEDIA_PROVIDER=backblaze only after configuring every B2 variable below.
CMS_MEDIA_PROVIDER=local
LOCAL_STORAGE_PATH=data/uploads
# Set these to values shown for your bucket in Backblaze. Region must match
# the endpoint host (https://s3.<region>.backblazeb2.com).
B2_ENDPOINT=
B2_REGION=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
STORAGE_PUBLIC_BASE_URL=

# Per-process Cloud SQL limits; restart/redeploy after changing.
# Queue limit 0 permits an unlimited queue; default is 100 waiting requests.
CMS_DB_CONNECTION_LIMIT=5
CMS_DB_QUEUE_LIMIT=100
CMS_DB_CONNECT_TIMEOUT_MS=10000
PORTAL_DB_CONNECTION_LIMIT=5
PORTAL_DB_QUEUE_LIMIT=100
PORTAL_DB_CONNECT_TIMEOUT_MS=10000
# E-services local database backup sidecar (configure off-site retention separately).
BACKUP_DB_HOST=host.docker.internal
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
