# ============================================================
# LGU Getafe Portal — Environment Template
# Copy this file to `.env` and fill in the real values.
# ============================================================
# Social media account URLs (drives the footer icon pack).
# Set a URL to display that platform's icon in the footer.
# Leave a variable empty (or remove it) to hide that icon.

# Facebook — has a built-in default URL in the code, so this is optional.
VITE_GETAFE_FACEBOOK_URL=

VITE_GETAFE_INSTAGRAM_URL=
VITE_GETAFE_YOUTUBE_URL=
VITE_GETAFE_X_URL=
VITE_GETAFE_GITHUB_URL=
VITE_GETAFE_WEBSITE_URL=
