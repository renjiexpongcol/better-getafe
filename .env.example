PORT=8080
# Per-instance application request ceilings. Edge protection should remain the
# primary DDoS control; see docs/DDOS_PROTECTION.md before going live.
RATE_LIMIT_PUBLIC_PER_MINUTE=240
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_SENSITIVE_PER_15_MINUTES=12
# Optional shared Redis state for horizontally scaled deployments. Leave empty
# only for development/single-instance fallback mode.
RATE_LIMIT_REDIS_URL=redis://redis:6379
# Comma-separated CIDRs of reverse proxies you operate. Forwarded client-IP
# headers are ignored unless the immediate peer matches one of these ranges.
RATE_LIMIT_TRUSTED_PROXY_CIDRS=
RATE_LIMIT_PUBLIC_BURST=40
RATE_LIMIT_API_BURST=30
RATE_LIMIT_API_MAX_DELAY_MS=500
RATE_LIMIT_SENSITIVE_BURST=4
RATE_LIMIT_INTENSIVE_PER_MINUTE=12
RATE_LIMIT_INTENSIVE_BURST=4
RATE_LIMIT_MAX_QUEUE_DEPTH=100
RATE_LIMIT_MAX_DELAYED_REQUESTS_PER_CLIENT=2
RATE_LIMIT_MAX_GLOBAL_DELAYED_REQUESTS=100
RATE_LIMIT_MAX_ACTIVE_REQUESTS=200
OPENWEATHER_API_KEY=
ACCUWEATHER_API_KEY=
APP_NAME=Municipality of Getafe
COMPANY_NAME=Municipality of Getafe
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en-PH
APP_CURRENCY=PHP
NODE_ENV=development
PUBLIC_SITE_URL=https://getafe.gov.ph
# Google OAuth (configure the same origins and redirect URI in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Optional SMS identity verification for Google-account onboarding (Semaphore PH)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
AUTH_LOCAL_FALLBACK=false

# Session Secrets (use one strong Secret Manager value across all Cloud Run instances)
AUTH_SESSION_SECRET=replace-with-a-long-random-secret-before-production
# Optional dedicated 32+ character key for encrypting authenticator secrets.
# If omitted, AUTH_SESSION_SECRET is used.
MFA_ENCRYPTION_KEY=
# CMS_SESSION_SECRET remains supported as a legacy alias.
CMS_ADMIN_PASSWORD=ChangeMe123!

# SQLite database (used for CMS and portal users)
CMS_DATABASE_PROVIDER=local
PORTAL_DATABASE_PROVIDER=local

# Backblaze B2 S3-compatible media storage
CMS_MEDIA_PROVIDER=backblaze
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_PUBLIC_BASE_URL=

# Per-process Cloud SQL limits; restart/redeploy after changing.
# Queue limit 0 permits an unlimited queue; default is 100 waiting requests.
CMS_DB_CONNECTION_LIMIT=5
CMS_DB_QUEUE_LIMIT=100
CMS_DB_CONNECT_TIMEOUT_MS=10000
PORTAL_DB_CONNECTION_LIMIT=5
PORTAL_DB_QUEUE_LIMIT=100
PORTAL_DB_CONNECT_TIMEOUT_MS=10000
