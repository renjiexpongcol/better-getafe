PORT=8080
NODE_ENV=development

# Session Secrets
CMS_SESSION_SECRET=replace-with-a-long-random-secret-before-production
CMS_ADMIN_PASSWORD=ChangeMe123!

# CMS Database (use 'local' for filesystem/JSON fallback, 'gcp' for Cloud SQL)
CMS_DATABASE_PROVIDER=local
CMS_CLOUD_SQL_INSTANCE=PROJECT_ID:REGION:INSTANCE_NAME
CMS_DB_NAME=better_getafe
CMS_DB_USER=
CMS_DB_PASSWORD=
CMS_IAM_AUTH=true

# Portal Users Database
PORTAL_DATABASE_PROVIDER=gcp
PORTAL_CLOUD_SQL_INSTANCE=PROJECT_ID:REGION:INSTANCE_NAME
PORTAL_DB_NAME=
PORTAL_DB_USER=
PORTAL_DB_PASSWORD=
PORTAL_IAM_AUTH=true

# Media Uploads (use 'local' for filesystem uploads, 'gcp' for Cloud Storage)
CMS_MEDIA_PROVIDER=local
GCS_BUCKET_NAME=your-bucket-name
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/your-bucket-name
