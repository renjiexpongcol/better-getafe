PORT=8080
CMS_SESSION_SECRET=replace-with-a-long-random-secret-before-production
CMS_ADMIN_PASSWORD=ChangeMe123!

# Local development uses the JSON database and uploads folder. Set both to
# "gcp" before deploying so incomplete cloud configuration blocks startup.
CMS_DATABASE_PROVIDER=local
CMS_MEDIA_PROVIDER=local

# Google Cloud SQL for MySQL (required when CMS_DATABASE_PROVIDER=gcp)
GCP_PROJECT_ID=getafemodernizationportal
INSTANCE_CONNECTION_NAME=getafemodernizationportal:asia-southeast1:getafe-portal
DB_NAME=getafe_cms
DB_USER=getafe-portal
DB_PASS=replace-with-a-secret-manager-secret
# The existing Cloud SQL instance currently permits public IP connectivity.
# The Cloud SQL connector should use PUBLIC until private networking is enabled.
PRIVATE_IP=false

# Google Cloud Storage (required when CMS_MEDIA_PROVIDER=gcp)
GCS_BUCKET=getafe-supra-storage
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/getafe-supra-storage
# Use Application Default Credentials locally; do not commit a key file.
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure-path\service-account.json
