PORT=8080
NODE_ENV=development
PUBLIC_SITE_URL=https://getafe.gov.ph

# Session Secrets
CMS_SESSION_SECRET=replace-with-a-long-random-secret-before-production
CMS_ADMIN_PASSWORD=ChangeMe123!

# CMS Database (use 'local' for filesystem/JSON fallback, 'gcp' for Cloud SQL)
CMS_DATABASE_PROVIDER=local
CMS_CLOUD_SQL_INSTANCE=getafemodernizationportal:asia-southeast1:getafe-portal
CMS_DB_NAME=getafe_cms
CMS_DB_USER=
CMS_DB_PASSWORD=
CMS_IAM_AUTH=true

# Portal Users Database
PORTAL_DATABASE_PROVIDER=gcp
PORTAL_CLOUD_SQL_INSTANCE=getafemodernizationportal:asia-southeast1:getafe-portal
PORTAL_DB_NAME=getafe-users
PORTAL_DB_USER=
PORTAL_DB_PASSWORD=
PORTAL_IAM_AUTH=true

# Media Uploads (use 'gcp' for Google Cloud Storage with direct signed-URL uploads)
CMS_MEDIA_PROVIDER=gcp
GCP_PROJECT_ID=getafemodernizationportal
GCS_BUCKET_NAME=getafe-supra-storage
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/getafe-supra-storage
