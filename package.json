  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@google-cloud/secret-manager": "^7.1.0",
    "@google-cloud/storage": "^8.2.0",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "redis": "^6.2.1",
    "sanitize-html": "^2.17.7"
