{
  "name": "getafe-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-runner.mjs",
    "dev:frontend": "node scripts/dev-runner.mjs",
    "dev:vite": "node scripts/dev-runner.mjs --frontend-only",
    "setup": "node scripts/setup.js",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "build": "vite build",
    "start": "node server.js",
    "test:traffic": "node scripts/test-traffic-protection.mjs",
    "test:eservices": "node --test scripts/test-eservices.mjs",
    "test:eservices-ui": "node scripts/test-eservices-ui.mjs",
    "backups:up": "docker compose -f docker-compose.yml -f docker-compose.backups.yml up -d --no-deps backups",
    "test:api-security": "node scripts/test-api-security.mjs",
    "test:api-security-http": "node scripts/test-api-security-http.mjs",
    "test:resident-preferences": "node --test scripts/test-resident-preferences.mjs",
    "test:settings-navigation": "node --test scripts/test-settings-navigation.mjs",
    "test:auth": "node --test scripts/test-auth-hardening.mjs",
    "test:admin-users": "node --test scripts/test-admin-users.mjs",
    "test:google-oauth": "node --test scripts/test-google-oauth.mjs",
    "cms:check": "node --env-file-if-exists=.env scripts/verify-cms-configuration.mjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "node scripts/dev-runner.mjs --preview",
    "migrate": "node scripts/migrate-settings.mjs",
    "migrate:postgres": "node scripts/migrate-postgresql.mjs",
    "media:reconcile": "node scripts/reconcile-media.mjs",
    "test:config": "node --test scripts/test-config-service.mjs",
    "test:appointments": "node --test scripts/test-appointment-scheduling.mjs",
    "test:media-paths": "node --test scripts/test-media-upload-paths.mjs",
    "test:officials": "node --test scripts/test-time-aware-officials.mjs",
    "test:routing": "node --test scripts/test-routing.mjs",
    "test:departments": "node scripts/test-departments.mjs",
    "test:request-cache": "node scripts/test-request-cache.mjs",
    "test:error-handling": "node --test scripts/test-error-handling.mjs",
    "test:redis": "node scripts/test-redis-services.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "test:b2-network": "node server/scripts/test-b2-network.js",
    "diagnose:b2": "node server/scripts/diagnose-b2.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@google-cloud/secret-manager": "^7.2.0",
    "@smithy/node-http-handler": "^4.12.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "redis": "^6.3.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "playwright": "^1.64.1",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
