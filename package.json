{
  "name": "getafe-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-runner.mjs",
    "dev:frontend": "node scripts/dev-runner.mjs",
    "dev:vite": "vite",
    "build": "vite build",
    "start": "node server.js",
    "test:traffic": "node scripts/test-traffic-protection.mjs",
    "cms:check": "node --env-file-if-exists=.env scripts/verify-cms-configuration.mjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "migrate": "node scripts/migrate-settings.mjs",
