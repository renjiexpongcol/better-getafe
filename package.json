{
  "name": "getafe-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-runner.mjs",
    "dev:frontend": "node scripts/dev-runner.mjs",
    "dev:vite": "vite",
    "build": "vite build",
    "start": "node server.js",
    "test:auth": "node scripts/test-auth-lifecycle.mjs",
    "test:traffic": "node scripts/test-traffic-protection.mjs",
    "cms:check": "node --env-file-if-exists=.env scripts/verify-cms-configuration.mjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "migrate": "node scripts/migrate-settings.mjs",
    "test:settings": "node --test scripts/test-config-service.mjs scripts/test-settings-api.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@google-cloud/cloud-sql-connector": "^1.11.3",
    "@google-cloud/secret-manager": "^7.1.0",
    "@google-cloud/storage": "^8.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "knex": "^3.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.37.0",
    "mssql": "^12.7.2",
    "mysql2": "^3.24.2",
    "nodemailer": "^10.0.9",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.3",
    "redis": "^5.12.1",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "vite": "^5.0.8"
  },
  "engines": {
    "node": ">=22"
  }
