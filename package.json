{
  "name": "getafe-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "worker:managed": "node server/managed-worker.js",
    "test:infrastructure-ui": "node scripts/test-infrastructure-status-ui.mjs",
    "test:production": "node --experimental-test-module-mocks --test scripts/test-production-runtime.mjs scripts/test-config-service.mjs scripts/test-scheduled-jobs.mjs scripts/test-postgres-pooling.mjs scripts/test-media-copy-engine.mjs scripts/test-deployment-contracts.mjs scripts/test-cloud-connections.mjs",
    "test": "node --experimental-test-module-mocks --test scripts/test-api-versioning.mjs scripts/test-appointment-scheduling.mjs scripts/test-error-handling.mjs scripts/test-google-oauth.mjs scripts/test-header-navigation.mjs scripts/test-media-upload-paths.mjs scripts/test-policy-editor.mjs scripts/test-policy-workspace.mjs scripts/test-postgres-lease.mjs scripts/test-readiness-probe.mjs scripts/test-request-cache.mjs scripts/test-resident-preferences.mjs scripts/test-route-inventory.mjs scripts/test-routing.mjs scripts/test-session-deadline.mjs scripts/test-settings-navigation.mjs scripts/test-start-runner-preflight.mjs scripts/test-statistics-service.mjs scripts/test-supabase-setup.mjs scripts/test-time-aware-officials.mjs scripts/test-session-endpoint.mjs scripts/test-session-renewal-race.mjs scripts/test-storage-selection.mjs scripts/test-storage-runtime.mjs scripts/test-dev-lifecycle.mjs scripts/test-psgc-startup-cache.mjs scripts/test-dependency-preflight.mjs",
    "lint:undefined": "eslint server src scripts server.js vite.config.js --rule no-undef:error --max-warnings 0",
    "dev": "node scripts/dev-runner.mjs",
    "setup": "node scripts/dev-runner.mjs --setup-only",
    "test:start-runner-preflight": "node --test scripts/test-start-runner-preflight.mjs",
    "build": "node scripts/build-frontend.mjs",
    "build:apps": "npm run build --workspace @getafe/public-web && npm run build --workspace @getafe/resident-app && npm run build --workspace @getafe/admin-portal",
    "deploy:artifacts": "node scripts/validate-deployment-artifacts.mjs",
    "deploy:smoke": "node scripts/test-deployment-runtime.mjs",
    "start": "node server.js",
    "backups:up": "docker compose -f docker-compose.backups.yml up -d --no-deps backups",
    "test:resident-preferences": "node --test scripts/test-resident-preferences.mjs",
    "test:settings-navigation": "node --test scripts/test-settings-navigation.mjs",
    "test:google-oauth": "node --test scripts/test-google-oauth.mjs",
    "lint": "eslint . --max-warnings 0",
    "preview": "node scripts/dev-runner.mjs --preview",
    "migrate:postgres": "node scripts/migrate-postgresql.mjs",
    "analytics:cleanup": "node --env-file-if-exists=.env server/scripts/cleanupWebsiteAnalytics.js",
    "test:config": "node --test scripts/test-config-service.mjs",
    "test:supabase-setup": "node --test scripts/test-supabase-setup.mjs",
    "test:appointments": "node --test scripts/test-appointment-scheduling.mjs",
    "test:media-paths": "node --test scripts/test-media-upload-paths.mjs",
    "test:officials": "node --test scripts/test-time-aware-officials.mjs",
    "test:routing": "node --test scripts/test-routing.mjs",
    "test:request-cache": "node scripts/test-request-cache.mjs",
    "test:error-handling": "node --test scripts/test-error-handling.mjs",
    "test:redis": "node --test scripts/test-managed-redis-config.mjs scripts/test-session-renewal-race.mjs",
    "test:b2-network": "node server/scripts/test-b2-network.js",
    "diagnose:b2": "node server/scripts/diagnose-b2.js",
    "audit:api-routes": "node scripts/route-inventory.mjs",
    "test:api-versioning": "node --test scripts/test-api-versioning.mjs",
    "test:api-route-inventory": "node --test scripts/test-route-inventory.mjs",
    "worker:integrations": "node server/integration-worker.js",
    "integrations:rotate-vault": "node server/integration-worker.js --rotate-vault",
    "test:header-navigation": "node --test scripts/test-header-navigation.mjs",
    "test:stabilization": "node --experimental-test-module-mocks --test scripts/test-session-endpoint.mjs scripts/test-storage-selection.mjs scripts/test-storage-runtime.mjs scripts/test-readiness-probe.mjs scripts/test-dev-lifecycle.mjs scripts/test-supabase-setup.mjs scripts/test-start-runner-preflight.mjs scripts/test-psgc-startup-cache.mjs",
    "test:session-timeout-ui": "node scripts/test-session-timeout-ui.mjs",
    "test:session-registry": "node --test scripts/test-session-renewal-race.mjs scripts/test-session-endpoint.mjs scripts/test-session-deadline.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "test:dependencies": "node --test scripts/test-dependency-preflight.mjs",
    "check:runtime": "node scripts/check-runtime-dependencies.mjs && node scripts/smoke-runtime.mjs",
    "postinstall": "node scripts/check-runtime-dependencies.mjs",
    "verify:production-install": "node scripts/verify-production-install.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "setup:database": "node scripts/dev-runner.mjs --database-only",
    "setup:cloud": "node scripts/setup-cloud.mjs",
    "verify:push": "node scripts/check-push-secrets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "@getafe/auth-client": "0.0.0",
    "@getafe/design-system": "0.0.0",
    "@getafe/ui": "0.0.0",
    "@smithy/node-http-handler": "^4.12.1",
    "@supabase/supabase-js": "^2.119.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.75.0",
    "nodemailer": "^10.5.0",
    "openai": "^7.62.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.6",
    "redis": "^6.3.1",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "espree": "^11.2.0",
    "ignore": "5.3.2",
    "playwright": "^1.65.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.21.0"
}
