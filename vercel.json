{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "node scripts/vercel-npm.mjs install",
  "buildCommand": "node scripts/vercel-npm.mjs build",
  "outputDirectory": "dist",
  "regions": ["syd1"],
  "env": { "NODE_OPTIONS": "--experimental-require-module" },
  "crons": [
    { "path": "/api/internal/jobs/psgc", "schedule": "0 16 * * *" },
    { "path": "/api/internal/jobs/media-cleanup", "schedule": "15 16 * * *" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "database/**" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/health/:path*", "destination": "/api" },
    { "source": "/healthz", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/ready", "destination": "/api" },
    { "source": "/rss.xml", "destination": "/api" },
    { "source": "/sitemap.xml", "destination": "/api" },
    { "source": "/uploads/:path*", "destination": "/api" },
    { "source": "/((?!api(?:/|$)|assets(?:/|$)|uploads(?:/|$)).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
